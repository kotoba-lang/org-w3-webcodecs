;; org-w3-webcodecs — raw W3C WebCodecs JS API thin wrapper (browser-only
;; VideoDecoder/VideoEncoder binding) plus a portable codec-string
;; parser/formatter (w3.webcodecs.codec-string, .cljc, has real tests).
;; Codec bitstream implementation lives one level up in kotoba-lang/utsushi,
;; the same way kami-webgpu is the EDN vocabulary layer above org-w3-webgpu.
{:paths ["src"]
 :deps {
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.11.1"}
        org.clojure/clojurescript {:mvn/version "1.11.132"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}
                      ;; TEST-ONLY. Parity compiles kotoba/w3/webcodecs/
                      ;; codec_string.{kotoba,cljk} to KIR and runs it against
                      ;; w3.webcodecs.codec-string. Nothing in :paths depends on
                      ;; either, and `:test-pure` runs the .cljc suite without
                      ;; them. Pins are the west pair and advance together.
                      io.github.kotoba-lang/amu
                      {:git/url "https://github.com/kotoba-lang/amu.git"
                       :git/sha "93c49982be32459b7671d70a308f0b8998b67477"}
                      io.github.kotoba-lang/osaho
                      {:git/url "https://github.com/kotoba-lang/osaho.git"
                       :git/sha "ff7a3ae2672f8ecdda54aa1abba3d480a2963733"}}
         :main-opts ["-m" "cognitect.test-runner"]}

  ;; The .cljc suite alone, with no compiler dependency.
  :test-pure
  {:extra-paths ["test"]
   :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
   :main-opts ["-m" "cognitect.test-runner" "-n" "w3.webcodecs.codec-string-test"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.03.13"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"]}}}
